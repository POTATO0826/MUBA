t256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint8\",\"name\":\"seat\",\"type\":\"uint8\"}],\"name\":\"Staked\",\"type\":\"event\"},{\"stateMutability\":\"payable\",\"type\":\"fallback\"},{\"inputs\":[],\"name\":\"BASE_SEPOLIA_CHAIN_ID\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"DOMAIN_SEPARATOR\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"MIN_STAKE\",\"outputs\":[{\"internalType\":\"uint128\",\"name\":\"\",\"type\":\"uint128\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"TIMEOUT\",\"outputs\":[{\"internalType\":\"uint64\",\"name\":\"\",\"type\":\"uint64\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"VERDICT_TYPEHASH\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"attestor\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"duelId\",\"type\":\"bytes32\"}],\"name\":\"cancel\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"duels\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"a\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"b\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"invited\",\"type\":\"address\"},{\"internalType\":\"uint128\",\"name\":\"stake\",\"type\":\"uint128\"},{\"internalType\":\"uint64\",\"name\":\"fullAt\",\"type\":\"uint64\"},{\"internalType\":\"enum DuelEscrow.Status\",\"name\":\"status\",\"type\":\"uint8\"},{\"internalType\":\"bool\",\"name\":\"aWithdrawn\",\"type\":\"bool\"},{\"internalType\":\"bool\",\"name\":\"bWithdrawn\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"duelId\",\"type\":\"bytes32\"}],\"name\":\"loseStake\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"duelId\",\"type\":\"bytes32\"}],\"name\":\"pool\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"duelId\",\"type\":\"bytes32\"}],\"name\":\"refund\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"duelId\",\"type\":\"bytes32\"}],\"name\":\"stake\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"duelId\",\"type\":\"bytes32\"},{\"internalType\":\"address payable\",\"name\":\"winner\",\"type\":\"address\"},{\"internalType\":\"uint64\",\"name\":\"deadline\",\"type\":\"uint64\"},{\"internalType\":\"bytes\",\"name\":\"sig\",\"type\":\"bytes\"}],\"name\":\"winStake\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"stateMutability\":\"payable\",\"type\":\"receive\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"refund(bytes32)\":{\"details\":\"This is an availability escape hatch, not a losing-player refund. Once `winStake` settles a duel, the loser has no claim.\"},\"stake(bytes32)\":{\"details\":\"The first stake must be at least 0.001 ETH. The second must match it exactly. Everyone is eligible, but an opener cannot take both seats and a full or completed duel accepts no additional stake.\"},\"winStake(bytes32,address,uint64,bytes)\":{\"details\":\"The caller is only a relay. Authority comes from the attestor's EIP-712 signature, bound to this chain, contract, duel, winner and deadline. State is finalized before ETH is sent.\"}},\"title\":\"DuelEscrow\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"cancel(bytes32)\":{\"notice\":\"Cancel an unmatched duel and recover its single stake.\"},\"loseStake(bytes32)\":{\"notice\":\"Voluntarily lose the stake and award the complete pool to the opponent. Only a seated player can forfeit; a third party cannot choose a loser or redirect the payout.\"},\"refund(bytes32)\":{\"notice\":\"Recover a stake if no signed result arrives within six hours.\"},\"stake(bytes32)\":{\"notice\":\"Open a duel or match its existing stake.\"},\"winStake(bytes32,address,uint64,bytes)\":{\"notice\":\"Pay the complete duel pool to the signed winner.\"}},\"notice\":\"Two-player, winner-takes-all duels using native Base Sepolia ETH. Anyone may call `stake`. The first caller opens a duel and chooses the stake; the second caller matches it exactly. A signed verdict from the immutable attestor names the winner, and anyone may relay that verdict with `winStake`. The winner receives the entire two-player pool. The loser receives nothing. This contract is intentionally testnet-only. Its constructor refuses to deploy on any chain other than Base Sepolia (chain id 84532).\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"DuelEscrow.sol\":\"DuelEscrow\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"DuelEscrow.sol\":{\"keccak256\":\"0xc38b734252743b0c8365d3135626f82b523c880605c903829589283e180a619b\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://67dead8ed9beada2b511a75445d34823373601b15c4dbbd3c60296581c2aca88\",\"dweb:/ipfs/QmVyiQittsLXt6PXCCtGKTCseyZGyDqnZ7cfp69vCXUAU1\"]}},\"version\":1}",
