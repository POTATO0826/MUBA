{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "bunVersion": "1.x",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/((?!api/|assets/|.*\\.[^/]+$).*)", "destination": "/index.html" }
  ]
}
