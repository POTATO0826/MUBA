# Public WalletConnect / Reown project id. Leave empty to use the local mock.
WALLETCONNECT_PROJECT_ID=

# The application is hard-pinned to Base Sepolia (chain id 84532). This value
# is documentary; setting it to mainnet does not change the wallet or server.
THETADUEL_NETWORK=base-sepolia

# Base Sepolia RPC used only by the server to verify escrow seats. There is no
# fallback to RPC_URL or any mainnet endpoint.
ESCROW_RPC_URL=https://sepolia.base.org

# Native-test-ETH DuelEscrow deployed through Remix on Base Sepolia.
THETADUEL_ESCROW=0xc683A484FC42eD99c48ad8E19F841388536deB3E

# GameStake: the two-function winner-takes-all pot. Independent of the escrow
# above — it has no attestor, no timeout and no refund.
THETADUEL_GAMESTAKE=

# Staking is opt-in and also requires a valid THETADUEL_ESCROW address.
THETADUEL_STAKE=off

# Mainnet-only market/options/trade paths are disabled by the server in this
# testnet build regardless of environment values.
THETADUEL_MARKET=off
THETADUEL_OPTIONS=off
THETADUEL_TRADE=off

# Verdict signer. The private key is server-only and never enters the client.
ATTESTOR_PRIVATE_KEY=

# Deployment-only variables used by contracts/deploy.ts.
ATTESTOR_ADDRESS=
DEPLOYER_PRIVATE_KEY=
