# WalletConnect / Reown project id. Create a project at
# https://dashboard.walletconnect.com, then add this app's origin to its
# allowed domains (localhost:3000 for dev) or wallets will refuse the session.
#
# Public value — it ships in the client bundle by design. Kept out of git only
# so each clone uses its own project.
#
# Leave it unset to run on the mock wallet.
WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Thetanuts integration. Every line below is optional: with none of them set
# the app runs exactly as it does today — seeded board, mock wallet, no chain.
# ---------------------------------------------------------------------------

# Base mainnet JSON-RPC. SECRET, server-only — it must never reach the bundle
# (test/secrets.test.ts fails the build if it does). An Alchemy/QuikNode Base
# key is strongly recommended: the public https://mainnet.base.org throttles
# hard under demo load and the book read is the first thing it drops.
RPC_URL=

# Live market data kill switch. OPT-OUT: anything but the literal `off` leaves
# the live book on. Set to `off` to serve the mock market and nothing else.
THETADUEL_MARKET=

# Market-priced parlay cards on the pick screen — real strikes, the option's own
# delta as the probability, a premium-derived payout. OPT-OUT, same shape as
# THETADUEL_MARKET above and for the same reason: it only reads. It reshapes the
# snapshot /api/market already served and hands the match a frozen value; it
# signs nothing and spends nothing. Set to `off` for the seeded cards. (Tickers
# with no live spot or no listed chain deal their seeded card either way.)
THETADUEL_OPTIONS=

# Real option fills on /desk. OPT-IN: must be exactly `on`. Spends real USDC on
# Base mainnet (code-capped at a few dollars). Leave unset for quotes only.
THETADUEL_TRADE=

# On-chain USDC duel stakes. OPT-IN: must be exactly `on`. Requires a deployed
# escrow + ATTESTOR_PRIVATE_KEY. Leave unset and duels stay PTS-only.
THETADUEL_STAKE=

# Our referrer address, tagged onto every fill for attribution (public).
# An un-whitelisted referrer's fee split is 0 bps — attribution, not revenue.
THETADUEL_REFERRER=

# Deployed DuelEscrow address on Base Sepolia (84532), public. `DuelEscrow`
# signs and settles alongside everything else this app signs — the book stays
# a Base mainnet (8453) read, always. Unset = staking UI stays off.
#
# Setting this ALSO switches on seat binding: `/api/lock` then reads each duel's
# two seats out of the escrow (`src/server/seats.ts`) and refuses any lock whose
# `a`/`b` are not the on-chain opener and joiner — finding X-1's residual. That
# read needs RPC_URL above, and it fails closed: with an escrow set and no RPC
# reachable, locks are refused rather than believed. So set both or neither;
# with neither, duels stay PTS-only and locks are signature-checked as before.
THETADUEL_ESCROW=

# The attestor EOA that signs settlement verdicts. SECRET, read by
# src/server/attest.ts ONLY — never imported under src/ client code, never
# bundled. Use a fresh unfunded key: it signs typed data, it never transacts.
ATTESTOR_PRIVATE_KEY=

# WHEN YOU NEED THIS: you almost certainly do not. The app detects a DNS filter
# on the book's host and resolves around it by itself — see "the automatic
# fallback" in src/server/resolver.ts — so a fresh clone with no .env at all
# gets a working arena. This line is for the two cases that leaves:
#
#   THETADUEL_DNS=1.1.1.1,8.8.8.8   pin the resolvers explicitly and skip the
#                                   probe. Useful if you already know your
#                                   network filters, or want a specific pair.
#   THETADUEL_DNS=off               turn the whole thing off — the explicit
#                                   override AND the automatic fallback — so
#                                   your network's answer is respected whatever
#                                   it says. Set this if a network operator
#                                   blocked the host on purpose and you want
#                                   that decision honoured. The board will be
#                                   empty and the footer will say why.
#
# WHAT THE UNDERLYING PROBLEM IS. Some networks block *.workers.dev by category
# (it is cheap to abuse for phishing), and the Thetanuts order book is served
# from a Cloudflare Worker — round-snowflake-9c31.devops-118.workers.dev. On
# such a network the resolver answers that host with a block-page address
# (146.112.61.104 / hit-block.opendns.com was the measured one), the block
# page's certificate does not validate, and the read fails with
# UNABLE_TO_GET_ISSUER_CERT_LOCALLY — while the Base mainnet RPC (`RPC_URL`
# above), which is not filtered, keeps working. That combination looks exactly
# like a venue outage and is not one. It has been misdiagnosed as one twice in
# this repo (see docs/book-endpoint.md). `bun run doctor` answers it in one
# command: it prints what your resolver and a public one each say about that
# host, side by side.
#
# It does NOT disable certificate validation, and must never be made to: the
# cert error above is the block page being correctly rejected, and the fix is
# to stop talking to the block page. Values must be literal IP addresses —
# hostnames are refused, because resolving the resolver would need the resolver
# being replaced. Anything malformed is refused and logged, never silently
# applied. Whenever this is doing anything at all, the server says so at
# startup and names the servers in use.
THETADUEL_DNS=

# Deploy key for contracts/deploy.ts ONLY. SECRET. Never referenced from src/.
# Needs ~$0.50 of Base Sepolia ETH (free from a faucet) for the one
# deployment, then nothing.
DEPLOYER_PRIVATE_KEY=

# The attestor's ADDRESS — public, and never its key. `contracts/deploy.ts`
# requires this: it is the constructor argument that fixes the referee for the
# life of the escrow, and there is no rotation. `bun scripts/check-attestor.ts`
# compares it against the address ATTESTOR_PRIVATE_KEY above actually derives
# to, which is the one transcription error that cannot be undone after deploy.
ATTESTOR_ADDRESS=

# Read-only RPC for scripts/check-attestor.ts and contracts/verify-deployment.ts.
# Optional: both default to https://sepolia.base.org, the public keyless
# endpoint. Set it only if you have a provider of your own — and if you do, note
# that a KEYED url is a secret (test/secrets.test.ts treats it as one) while the
# public default is not.
ESCROW_RPC_URL=
